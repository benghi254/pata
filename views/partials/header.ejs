<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#05060f">
    <title><%= title %> · PATA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800&family=Space+Grotesk:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="site-header">
        <div class="wrap">
            <a href="/" class="logo grad-text">PATA</a>
            <nav class="nav">
                <a href="/">Browse</a>
                <a href="/sell">Sell</a>
                <% if (user) { %>
                    <span class="hello">Hi, <strong><%= user.firstName %></strong></span>
                    <form action="/logout" method="post" class="inline"><button type="submit" class="linklike">Log out</button></form>
                <% } else { %>
                    <a href="/login">Log in</a>
                    <a href="/signup" class="btn btn-primary btn-sm">Sign up</a>
                <% } %>
            </nav>
        </div>
    </header>
