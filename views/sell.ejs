<%- include('partials/header') %>
<div class="wrap">
    <section class="hero">
        <span class="eyebrow">Sell on PATA</span>
        <h1>Put your business <span class="grad-text">on the map.</span></h1>
        <p class="lead">Advertise to the buyers around you. Looking to buy instead? <a href="/">Browse listings</a>, no account needed.</p>
        <% if (!user) { %>
            <div class="seller-cta">
                <p><strong>Selling needs a free seller account.</strong> Buyers never need one.</p>
                <div class="actions">
                    <a href="/signup" class="btn btn-primary">Create a seller account</a>
                    <a href="/login?next=/sell" class="btn">Seller login</a>
                </div>
            </div>
        <% } %>
    </section>
    <div class="choices">
        <a class="card choice" href="/sell/goods">
            <div class="icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </div>
            <h2>Sell goods</h2>
            <p>Groceries, mutura, clothing, foodstuff: list your products and get found by nearby buyers.</p>
            <span class="go grad-text"><strong>List a product →</strong></span>
        </a>
        <a class="card choice" href="/sell/services">
            <div class="icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.8-3.8a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9z"/></svg>
            </div>
            <h2>Offer a service</h2>
            <p>Plumber, electrician, mason, mama fua, mechanic, boda rider or any other trade: let people in your area find and call you.</p>
            <span class="go grad-text"><strong>List a service →</strong></span>
        </a>
    </div>
</div>
<%- include('partials/footer') %>
