<%# Read-only star row. Locals: value (0-5, may be fractional), size ('sm' | 'lg' | ''). %><%
  const pct = Math.max(0, Math.min(100, (Number(value) || 0) / 5 * 100));
%><span class="stars <%= typeof size !== 'undefined' ? size : '' %>" role="img" aria-label="<%= (Number(value) || 0).toFixed(1) %> out of 5 stars"><span class="stars-on" style="width: <%= pct.toFixed(1) %>%">★★★★★</span>★★★★★</span>
