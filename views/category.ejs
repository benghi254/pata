<%- include('partials/header') %>
<div class="wrap">
    <section class="banner">
        <img src="/img/<%= category.image %>" alt="">
        <div class="inner">
            <div>
                <span class="eyebrow"><%= category.kind === 'goods' ? 'Goods' : 'Services' %></span>
                <h1><%= category.name %></h1>
                <p><%= category.blurb %></p>
            </div>
            <span class="chip <%= listings.length ? 'live' : '' %>"><%= listings.length %> listed</span>
        </div>
    </section>

    <% if (!listings.length) { %>
        <div class="empty">
            <h2>Nobody here yet</h2>
            <p>Be the first <%= category.kind === 'goods' ? 'seller' : 'expert' %> in <%= category.name %>.</p>
            <a href="/sell/<%= category.kind %>" class="btn btn-primary">Create a listing</a>
        </div>
    <% } else { %>
        <div class="grid section">
            <% listings.forEach(function (l) { %>
                <article class="card lift listing">
                    <div class="top">
                        <div class="avatar"><%= l.shop_name.charAt(0).toUpperCase() %></div>
                        <div>
                            <h3><%= l.shop_name %></h3>
                            <div class="what"><%= l.title %></div>
                        </div>
                    </div>
                    <% if (l.description) { %><p class="desc"><%= l.description %></p><% } %>
                    <div class="meta">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                        <%= [l.ward, l.constituency, l.county].filter(Boolean).join(', ') %>
                    </div>
                    <a class="btn btn-block" href="tel:<%= l.phone.replace(/\s/g, '') %>">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
                        <%= l.phone %>
                    </a>
                </article>
            <% }) %>
        </div>
    <% } %>
</div>
<%- include('partials/footer') %>
