<%- include('partials/header') %>
<% const base = '/listing/' + listing.id; const here = base + '/inventory' + (filter !== 'all' || q ? '?' + new URLSearchParams(Object.assign({}, filter !== 'all' ? { show: filter } : {}, q ? { q: q } : {})) : ''); %>
<div class="wrap">
    <section class="section-head page-head">
        <div>
            <a href="/my/listings" class="back">← My shops</a><br>
            <span class="eyebrow">Inventory</span>
            <h1><%= listing.shop_name %></h1>
            <p>Your catalogue: prices, stock and everything that changed. Buyers see the items you show on your shop page.</p>
        </div>
        <div class="head-actions">
            <% if (can.items) { %><a href="<%= base %>/items/new" class="btn btn-primary btn-sm">+ Add item</a><% } %>
            <a href="<%= listingPath(listing) %>" class="btn btn-sm">View shop</a>
            <% if (can.reports) { %>
                <a href="<%= base %>/inventory/history" class="btn btn-sm">History</a>
                <a href="<%= base %>/inventory.csv" class="btn btn-sm">Export CSV</a>
            <% } %>
            <% if (can.role === 'owner') { %><a href="<%= base %>/team" class="btn btn-sm">Team</a><% } %>
        </div>
    </section>

    <% if (can.role !== 'owner') { %>
        <p class="buyer-note">You help run this shop. You can: <strong><%= permSummary(can) %></strong>. Ask the owner if you need more.</p>
    <% } %>
    <% if (flash) { %><p class="notice <%= flash.type === 'bad' ? 'bad' : '' %>" role="status"><%= flash.text %></p><% } %>

    <div class="inv-stats">
        <div class="stat"><b><%= summary.items %></b><span>Items</span></div>
        <div class="stat"><b><%= summary.units.toLocaleString('en-KE') %></b><span>Units in stock</span></div>
        <% if (can.reports) { %><div class="stat"><b><%= kes(summary.value) %></b><span>Stock value</span></div><% } %>
        <a class="stat <%= summary.low ? 'is-warn' : '' %>" href="<%= base %>/inventory?show=low"><b><%= summary.low %></b><span>Low stock</span></a>
        <a class="stat <%= summary.out ? 'is-bad' : '' %>" href="<%= base %>/inventory?show=out"><b><%= summary.out %></b><span>Out of stock</span></a>
    </div>

    <% if (!summary.items) { %>
        <div class="empty">
            <h2>Your catalogue is empty</h2>
            <% if (can.items) { %>
                <p>Add the products or services you sell, with prices and how many you have. You can update stock any time, from your phone.</p>
                <a href="<%= base %>/items/new" class="btn btn-primary">Add your first item</a>
            <% } else { %>
                <p>No items have been added yet.</p>
            <% } %>
        </div>
    <% } else { %>
        <div class="inv-grid <%= can.reports ? '' : 'solo' %>">
            <div>
                <div class="inv-toolbar">
                    <nav class="filters" aria-label="Filter items">
                        <% Object.entries(filters).forEach(function ([key, f]) { %>
                            <a class="pill <%= filter === key ? 'on' : '' %>" href="<%= base %>/inventory<%= key === 'all' ? '' : '?show=' + key %>" <%= filter === key ? 'aria-current=page' : '' %>><%= f.label %></a>
                        <% }) %>
                    </nav>
                    <form class="inv-search" method="get" action="<%= base %>/inventory" role="search">
                        <% if (filter !== 'all') { %><input type="hidden" name="show" value="<%= filter %>"><% } %>
                        <label for="q" class="visually-hidden">Search items</label>
                        <input id="q" type="search" name="q" value="<%= q %>" placeholder="Search name or SKU">
                    </form>
                </div>

                <% if (!items.length) { %>
                    <p class="hint">No items match. <a href="<%= base %>/inventory">Show all</a></p>
                <% } %>

                <div class="inv-list">
                    <% items.forEach(function (i) { const st = stockState(i); %>
                        <article class="card inv-item <%= i.visible ? '' : 'is-hidden' %>" id="item-<%= i.id %>">
                            <div class="inv-main">
                                <div class="inv-name">
                                    <h2 class="h-card"><%= i.name %></h2>
                                    <div class="meta-line">
                                        <% if (i.price != null) { %><span class="price"><%= kes(i.price) %><% if (i.unit) { %> <span class="muted"><%= i.unit %></span><% } %></span><% } else { %><span class="muted">No price</span><% } %>
                                        <% if (i.sku) { %><span class="muted">SKU <%= i.sku %></span><% } %>
                                        <span class="chip stock-<%= st.key %>"><%= st.key === 'untracked' ? 'Not counted' : st.label %></span>
                                        <% if (!i.visible) { %><span class="chip">Hidden</span><% } %>
                                    </div>
                                </div>
                                <% if (i.quantity != null) { %>
                                    <div class="qty stock-<%= st.key %>" title="In stock"><b><%= i.quantity %></b><span>in stock</span></div>
                                <% } %>
                            </div>

                            <% if (i.quantity != null && can.stock) { %>
                                <div class="inv-stock">
                                    <form method="post" action="<%= base %>/items/<%= i.id %>/stock" class="quick">
                                        <input type="hidden" name="next" value="<%= here %>#item-<%= i.id %>">
                                        <input type="hidden" name="move" value="sold"><input type="hidden" name="amount" value="1">
                                        <button class="btn btn-sm" type="submit" <%= i.quantity === 0 ? 'disabled' : '' %> aria-label="Sold one <%= i.name %>">−1 Sold</button>
                                    </form>
                                    <form method="post" action="<%= base %>/items/<%= i.id %>/stock" class="quick">
                                        <input type="hidden" name="next" value="<%= here %>#item-<%= i.id %>">
                                        <input type="hidden" name="move" value="restock"><input type="hidden" name="amount" value="1">
                                        <button class="btn btn-sm" type="submit" aria-label="Add one <%= i.name %>">+1</button>
                                    </form>
                                    <form method="post" action="<%= base %>/items/<%= i.id %>/stock" class="move">
                                        <input type="hidden" name="next" value="<%= here %>#item-<%= i.id %>">
                                        <label class="visually-hidden" for="move-<%= i.id %>">What happened</label>
                                        <select id="move-<%= i.id %>" name="move">
                                            <% Object.entries(moves).forEach(function ([key, m]) { %>
                                                <option value="<%= key %>"><%= m.sign > 0 ? '+ ' : m.sign < 0 ? '− ' : '= ' %><%= m.label %></option>
                                            <% }) %>
                                        </select>
                                        <label class="visually-hidden" for="amount-<%= i.id %>">How many</label>
                                        <input id="amount-<%= i.id %>" type="number" name="amount" min="0" step="1" inputmode="numeric" placeholder="Qty" required>
                                        <label class="visually-hidden" for="note-<%= i.id %>">Note</label>
                                        <input id="note-<%= i.id %>" type="text" name="note" maxlength="200" placeholder="Note (optional)">
                                        <button class="btn btn-sm btn-primary" type="submit">Update</button>
                                    </form>
                                </div>
                            <% } %>

                            <% if (can.items || can.reports || can.delete) { %>
                            <div class="inv-actions">
                                <% if (can.items) { %>
                                    <a class="btn btn-sm" href="<%= base %>/items/<%= i.id %>/edit">Edit</a>
                                    <form method="post" action="<%= base %>/items/<%= i.id %>/visibility" class="inline">
                                        <input type="hidden" name="next" value="<%= here %>#item-<%= i.id %>">
                                        <input type="hidden" name="visible" value="<%= i.visible ? '0' : '1' %>">
                                        <button class="btn btn-sm" type="submit"><%= i.visible ? 'Hide' : 'Show' %></button>
                                    </form>
                                <% } %>
                                <% if (can.reports) { %><a class="btn btn-sm" href="<%= base %>/inventory/history?item=<%= i.id %>">History</a><% } %>
                                <% if (can.delete) { %>
                                    <form method="post" action="<%= base %>/items/<%= i.id %>/delete" class="inline confirm-delete" data-name="<%= i.name %>">
                                        <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                                    </form>
                                <% } %>
                            </div>
                            <% } %>
                        </article>
                    <% }) %>
                </div>
            </div>

            <% if (can.reports) { %>
            <aside class="card pad inv-recent">
                <h2 class="h-sm">Recent changes</h2>
                <% if (!recent.length) { %><p class="hint">Nothing yet.</p><% } %>
                <ol class="changes">
                    <% recent.forEach(function (c) { %>
                        <%- include('partials/change', { c: c, actions: actions }) %>
                    <% }) %>
                </ol>
                <a href="<%= base %>/inventory/history" class="btn btn-sm btn-block">See all history</a>
            </aside>
            <% } %>
        </div>
    <% } %>
</div>
<script src="/js/confirm-delete.js" defer></script>
<%- include('partials/footer') %>
