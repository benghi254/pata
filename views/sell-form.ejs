<%- include('partials/header') %>
<div class="wrap panel-page">
    <div class="panel wide">
        <% if (editing) { %>
            <a href="/my/listings" class="back">← My shops</a>
            <span class="eyebrow">Editing</span>
            <h1><%= editing.shop_name %></h1>
        <% } else { %>
            <span class="eyebrow"><%= kind === 'goods' ? 'New product' : 'New service' %></span>
            <h1><%= kind === 'goods' ? 'List a product' : 'List a service' %></h1>
        <% } %>
        <p class="sub"><%= heading %>.</p>
        <%- include('partials/errors', { errors: errors }) %>
        <form action="<%= action %>" method="post">
            <fieldset>
                <legend><%= kind === 'goods' ? 'Product details' : 'Service details' %></legend>
                <div class="cols">
                    <div class="field">
                        <label for="title"><%= kind === 'goods' ? 'Product name' : 'Service you offer' %></label>
                        <input id="title" type="text" name="title" value="<%= values.title || '' %>" placeholder="<%= kind === 'goods' ? 'e.g. Sukuma wiki' : 'e.g. Fades and line-ups' %>" required>
                    </div>
                    <div class="field">
                        <label for="shopName">Shop / business name</label>
                        <input id="shopName" type="text" name="shopName" value="<%= values.shopName || '' %>" required>
                    </div>
                    <div class="field span">
                        <label for="category">Category</label>
                        <select id="category" name="category" required>
                            <option value="">Choose a category</option>
                            <% options.forEach(function (c) { %>
                                <option value="<%= c.slug %>" <%= values.category === c.slug ? 'selected' : '' %>><%= c.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="field span">
                        <label for="description">Description <span class="opt">(optional)</span></label>
                        <textarea id="description" name="description" rows="3" placeholder="What makes you stand out?"><%= values.description || '' %></textarea>
                    </div>
                </div>
            </fieldset>
            <fieldset>
                <legend>Contact &amp; location</legend>
                <div class="cols">
                    <div class="field">
                        <label for="phone">Phone</label>
                        <input id="phone" type="tel" name="phone" value="<%= values.phone || '' %>" placeholder="0712 345678" autocomplete="tel" required>
                    </div>
                    <div class="field">
                        <label for="county">County</label>
                        <input id="county" type="text" name="county" value="<%= values.county || '' %>" placeholder="e.g. Nairobi" required>
                    </div>
                    <div class="field">
                        <label for="constituency">Constituency <span class="opt">(optional)</span></label>
                        <input id="constituency" type="text" name="constituency" value="<%= values.constituency || '' %>">
                    </div>
                    <div class="field">
                        <label for="ward">Ward <span class="opt">(optional)</span></label>
                        <input id="ward" type="text" name="ward" value="<%= values.ward || '' %>">
                    </div>
                    <div class="field span">
                        <label for="street">Street, building or landmark</label>
                        <input id="street" type="text" name="street" value="<%= values.street || '' %>" placeholder="e.g. Shop 4, Kangemi Market, opposite Total petrol station" required>
                    </div>
                </div>
            </fieldset>
            <fieldset>
                <legend>Exact location on the map <span class="opt">(recommended)</span></legend>
                <p class="hint">Tap the map where your shop is, or use your phone's location while you're at the shop. You can drag the pin to adjust it.</p>
                <div class="map-tools">
                    <button type="button" class="btn btn-sm" id="locate">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="8"/></svg>
                        Use my current location
                    </button>
                    <button type="button" class="btn btn-sm" id="clear-pin" hidden>Remove pin</button>
                    <span class="coords" id="coords" aria-live="polite"></span>
                </div>
                <div id="picker" class="map" data-lat="<%= values.latitude || '' %>" data-lng="<%= values.longitude || '' %>"></div>
                <input type="hidden" name="latitude" id="latitude" value="<%= values.latitude || '' %>">
                <input type="hidden" name="longitude" id="longitude" value="<%= values.longitude || '' %>">
            </fieldset>
            <fieldset>
                <legend>Opening hours</legend>
                <p class="hint">Untick the days you're closed. If you close after midnight, set the closing time earlier than the opening time (e.g. 6:00 PM to 2:00 AM).</p>
                <div class="hours">
                    <% days.forEach(function (d) { const h = values.hours && values.hours[d[0]]; %>
                        <div class="hours-row" data-day="<%= d[0] %>">
                            <label class="day">
                                <input type="checkbox" name="<%= d[0] %>_isOpen" <%= h ? 'checked' : '' %>>
                                <span><%= d[1] %></span>
                            </label>
                            <input type="time" name="<%= d[0] %>_open" value="<%= h ? h.open : '08:00' %>" aria-label="<%= d[1] %> opening time" <%= h ? '' : 'disabled' %>>
                            <span class="to">to</span>
                            <input type="time" name="<%= d[0] %>_close" value="<%= h ? h.close : '18:00' %>" aria-label="<%= d[1] %> closing time" <%= h ? '' : 'disabled' %>>
                            <span class="closed-tag">Closed</span>
                        </div>
                    <% }) %>
                </div>
                <button type="button" class="btn btn-sm" id="copy-monday">Copy Monday's hours to all open days</button>
            </fieldset>
            <button type="submit" class="btn btn-primary btn-block"><%= editing ? 'Save changes' : (kind === 'goods' ? 'Publish product' : 'Publish service') %></button>
        </form>
        <% if (editing) { %>
            <div class="danger-zone">
                <div>
                    <strong>Delete this listing</strong>
                    <p class="hint">It will disappear from PATA and search results. This can't be undone.</p>
                </div>
                <form action="/listing/<%= editing.id %>/delete" method="post" class="confirm-delete" data-name="<%= editing.shop_name %>">
                    <button type="submit" class="btn btn-sm btn-danger">Delete listing</button>
                </form>
            </div>
        <% } %>
    </div>
</div>
<script src="/js/sell-form.js" defer></script>
<% if (editing) { %><script src="/js/confirm-delete.js" defer></script><% } %>
<%- include('partials/footer') %>
