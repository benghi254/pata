<%
  const pageDescription = typeof description !== 'undefined' ? description
    : 'PATA is the online marketplace that links buyers with local shops, vendors and service providers near them.';
  const canonicalUrl = typeof canonical !== 'undefined' ? siteUrl + canonical : null;
  const imageUrl = siteUrl + (typeof ogImage !== 'undefined' ? ogImage : '/img/veges.jpg');
  const fullTitle = title + ' · PATA';
%><!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f6f7ff">
    <title><%= fullTitle %></title>
    <meta name="description" content="<%= pageDescription %>">
    <% if (typeof noindex !== 'undefined' && noindex) { %>
    <meta name="robots" content="noindex, follow">
    <% } %>
    <% if (canonicalUrl) { %>
    <link rel="canonical" href="<%= canonicalUrl %>">
    <% } %>

    <meta property="og:site_name" content="PATA">
    <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
    <meta property="og:title" content="<%= fullTitle %>">
    <meta property="og:description" content="<%= pageDescription %>">
    <meta property="og:image" content="<%= imageUrl %>">
    <% if (canonicalUrl) { %><meta property="og:url" content="<%= canonicalUrl %>"><% } %>
    <meta property="og:locale" content="en_KE">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= fullTitle %>">
    <meta name="twitter:description" content="<%= pageDescription %>">
    <meta name="twitter:image" content="<%= imageUrl %>">

    <% if (typeof jsonLd !== 'undefined') { [].concat(jsonLd).forEach(function (d) { %>
    <script type="application/ld+json"><%- jsonLdScript(d) %></script>
    <% }) } %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800&family=Space+Grotesk:wght@400;500;600;700&display=swap">
    <% if (typeof map !== 'undefined' && map) { %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin="" defer></script>
    <% } %>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="site-header">
        <div class="wrap">
            <a href="/" class="logo grad-text">PATA</a>
            <% if (path !== '/' && path !== '/search') { %>
            <form class="head-search" role="search" action="/search" method="get">
                <label for="head-q" class="visually-hidden">Search shops and services in your constituency</label>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input id="head-q" name="q" type="search" placeholder="<%= area ? 'Search in ' + area.constituency + '…' : 'Search near you…' %>" autocomplete="off" enterkeyhint="search">
            </form>
            <% } %>
            <a class="area-chip" href="/area?next=<%= encodeURIComponent(here) %>" title="Change your constituency">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                <%= area ? area.constituency : 'Choose your area' %>
            </a>
            <nav class="nav">
                <a href="/">Browse</a>
                <a href="/sell">Sell</a>
                <% if (typeof buyerSession !== 'undefined' && buyerSession) { %><a href="/orders">My orders</a><% } %>
                <% if (user) { %>
                    <a href="/my/listings">My shops</a>
                    <span class="hello">Hi, <strong><%= user.firstName %></strong></span>
                    <form action="/logout" method="post" class="inline"><button type="submit" class="linklike">Log out</button></form>
                <% } else { %>
                    <a href="/login">Seller login</a>
                    <a href="/signup" class="btn btn-primary btn-sm">Become a seller</a>
                <% } %>
            </nav>
        </div>
    </header>
    <main>
