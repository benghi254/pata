<%- include('partials/header') %>
<div class="wrap">
    <section class="banner <%= category.image ? '' : 'no-photo' %>" style="--h: <%= category.hue || 260 %>">
        <% if (category.image) { %><img src="/img/<%= category.image %>" alt=""><% } else { %><span class="banner-icon" aria-hidden="true"><%= category.icon %></span><% } %>
        <div class="inner">
            <div>
                <span class="eyebrow"><%= category.group %></span>
                <h1><%= category.name %></h1>
                <p><%= category.blurb %></p>
            </div>
            <% if (area) { %><span class="chip <%= listings.length ? 'live' : '' %>"><%= listings.length %> in <%= area.constituency %></span><% } %>
        </div>
    </section>

    <% if (!area) { %>
        <div class="section"><%- include('partials/area-picker', { next: '/category/' + category.slug }) %></div>
    <% } else if (!listings.length) { %>
        <div class="empty">
            <h2>Nobody in <%= area.constituency %> yet</h2>
            <p>No <%= category.name.toLowerCase() %> have listed in <%= area.constituency %> constituency yet. Be the first <%= category.kind === 'goods' ? 'seller' : 'expert' %> here.</p>
            <a href="/sell/<%= category.kind %>" class="btn btn-primary">Create a listing</a>
        </div>
    <% } else { %>
        <div class="grid section">
            <% listings.forEach(function (l) { %><%- include('partials/listing-card', { l: l }) %><% }) %>
        </div>
    <% } %>

    <% if (related.length) { %>
        <nav class="related" aria-label="Related categories">
            <h2 class="h-sm">More in <%= category.group %></h2>
            <div class="related-list">
                <% related.forEach(function (c) { %>
                    <a class="pill lg" href="/category/<%= c.slug %>"><span aria-hidden="true"><%= c.icon %></span> <%= c.name %></a>
                <% }) %>
            </div>
        </nav>
    <% } %>
</div>
<%- include('partials/footer') %>
