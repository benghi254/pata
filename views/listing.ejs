<%- include('partials/header') %>
<% const hasPin = listing.latitude != null && listing.longitude != null; %>
<div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span>
        <a href="/category/<%= category.slug %>"><%= category.name %></a> <span>/</span>
        <span aria-current="page"><%= listing.shop_name %></span>
    </nav>

    <section class="shop-head">
        <div class="avatar lg"><%= listing.shop_name.charAt(0).toUpperCase() %></div>
        <div class="shop-title">
            <span class="eyebrow"><%= category.name %></span>
            <h1><%= listing.shop_name %></h1>
            <p class="what"><%= listing.title %></p>
        </div>
        <% if (can) { %>
            <a href="/listing/<%= listing.id %>/inventory" class="btn btn-sm">Manage inventory</a>
            <% if (can.shop) { %><a href="/listing/<%= listing.id %>/edit" class="btn btn-sm">Edit listing</a><% } %>
        <% } %>
        <% if (status) { %>
            <span class="status <%= status.isOpen ? 'open' : 'closed' %>"><%= status.label %></span>
        <% } %>
    </section>

    <div class="shop-grid">
        <div class="shop-main">
            <% if (shopPhotos.length) { %>
                <div class="gallery n<%= Math.min(shopPhotos.length, 4) %>">
                    <% shopPhotos.forEach(function (p, i) { %>
                        <a href="<%= photoUrl(p.id) %>" target="_blank" rel="noopener"><img src="<%= photoUrl(p.id) %>" alt="<%= listing.shop_name %> photo <%= i + 1 %>" <%= i ? 'loading="lazy"' : '' %>></a>
                    <% }) %>
                </div>
            <% } %>
            <% if (listing.description) { %>
                <div class="card pad">
                    <h2 class="h-sm">About</h2>
                    <p class="desc"><%= listing.description %></p>
                </div>
            <% } %>

            <% if (items.length) { %>
                <div class="card pad">
                    <h2 class="h-sm"><%= listing.kind === 'goods' ? 'Products' : 'Services' %> &amp; prices</h2>
                    <ul class="catalogue">
                        <% items.forEach(function (i) { const st = stockState(i); const pics = itemPhotos[i.id] || []; %>
                            <li class="<%= st.key === 'out' ? 'is-out' : '' %> <%= pics.length ? 'has-pic' : '' %>">
                                <% if (pics.length) { %>
                                    <div class="cat-pics">
                                        <% pics.forEach(function (id, n) { %><a href="<%= photoUrl(id) %>" target="_blank" rel="noopener" class="<%= n ? 'more' : '' %>"><img src="<%= photoUrl(id) %>" alt="<%= i.name %><%= n ? ' photo ' + (n + 1) : '' %>" loading="lazy"></a><% }) %>
                                    </div>
                                <% } %>
                                <div class="cat-name">
                                    <strong><%= i.name %></strong>
                                    <% if (i.description) { %><span class="muted"><%= i.description %></span><% } %>
                                </div>
                                <div class="cat-right">
                                    <% if (i.price != null) { %><span class="price"><%= kes(i.price) %><% if (i.unit) { %> <span class="muted"><%= i.unit %></span><% } %></span><% } %>
                                    <% if (st.key !== 'untracked') { %><span class="chip stock-<%= st.key %>"><%= st.label %></span><% } %>
                                </div>
                            </li>
                        <% }) %>
                    </ul>
                    <p class="hint">Prices and stock are kept up to date by the seller. Call to confirm.</p>
                </div>
            <% } else if (can && can.items) { %>
                <div class="card pad">
                    <h2 class="h-sm">Products &amp; prices</h2>
                    <p class="hint">Only you can see this. Add your products, prices and stock so buyers know what you have.</p>
                    <a href="/listing/<%= listing.id %>/items/new" class="btn btn-sm btn-primary">+ Add items</a>
                </div>
            <% } %>

            <div class="card pad">
                <h2 class="h-sm">Location</h2>
                <address class="addr">
                    <span><%= listing.street %></span>
                    <span class="muted"><%= place(listing) %></span>
                </address>
                <% if (hasPin) { %>
                    <div id="shop-map" class="map" data-lat="<%= listing.latitude %>" data-lng="<%= listing.longitude %>" data-name="<%= listing.shop_name %>"></div>
                <% } else { %>
                    <p class="hint">This seller hasn't pinned their shop on the map yet.</p>
                <% } %>
            </div>
        </div>

        <aside class="shop-side">
            <div class="card pad">
                <h2 class="h-sm">Contact</h2>
                <a class="btn btn-primary btn-block" href="tel:<%= listing.phone.replace(/\s/g, '') %>">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
                    Call <%= listing.phone %>
                </a>
                <% if (listing.website) { %>
                    <a class="btn btn-block" href="<%= listing.website %>" target="_blank" rel="noopener nofollow ugc">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                        Visit our website
                    </a>
                <% } %>
                <a class="btn btn-block" target="_blank" rel="noopener"
                   href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(hasPin ? listing.latitude + ',' + listing.longitude : [listing.street, place(listing), 'Kenya'].join(', ')) %>">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m3 11 19-9-9 19-2-8z"/></svg>
                    Get directions
                </a>
            </div>

            <% if (payment) { %>
                <div class="card pad pay-card">
                    <h2 class="h-sm">Pay with <%= payment.provider %></h2>
                    <dl class="pay-details">
                        <div>
                            <dt><%= payment.label %> · <%= payment.numberLabel %></dt>
                            <dd>
                                <span class="pay-number"><%= payment.display %></span>
                                <button type="button" class="btn btn-sm copy-btn" data-copy="<%= payment.copyValue %>" hidden>Copy</button>
                            </dd>
                        </div>
                        <% if (payment.account) { %>
                            <div>
                                <dt>Account number</dt>
                                <dd>
                                    <span class="pay-number"><%= payment.account %></span>
                                    <button type="button" class="btn btn-sm copy-btn" data-copy="<%= payment.account %>" hidden>Copy</button>
                                </dd>
                            </div>
                        <% } %>
                    </dl>
                    <ol class="pay-steps">
                        <% payment.steps.forEach(function (s) { %><li><%= s %></li><% }) %>
                    </ol>
                    <p class="pay-warn">Before you enter your PIN, check that the name <%= payment.provider %> shows matches <strong><%= listing.shop_name %></strong>. If it doesn't, don't pay.</p>
                </div>
            <% } %>

            <div class="card pad">
                <h2 class="h-sm">Opening hours</h2>
                <% if (week) { %>
                    <table class="week">
                        <% week.forEach(function (d) { %>
                            <tr class="<%= d.isToday ? 'today' : '' %>">
                                <th scope="row"><%= d.name %></th>
                                <td class="<%= d.text === 'Closed' ? 'muted' : '' %>"><%= d.text %></td>
                            </tr>
                        <% }) %>
                    </table>
                    <p class="hint">Times are East Africa Time.</p>
                <% } else { %>
                    <p class="hint">No opening hours given. Call to check.</p>
                <% } %>
            </div>
        </aside>
    </div>
</div>
<% if (hasPin) { %><script src="/js/listing-map.js" defer></script><% } %>
<% if (payment) { %><script src="/js/copy.js" defer></script><% } %>
<%- include('partials/footer') %>
