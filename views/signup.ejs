<%- include('partials/header') %>
        <div class="main">
            <div class="wlcom">
                <h4>WELCOME TO PATA</h4>
                <p>The online marketplace where you can buy and sell goods and services without any third parties.</p>
            </div>
            <div class="form">
                <h3>Sign Up</h3>
                <%- include('partials/errors', { errors: errors }) %>
                <form action="/signup" method="post">
                    <label>Email:<br><input type="email" name="email" value="<%= values.email || '' %>" required></label><br>
                    <label>First Name:<br><input type="text" name="firstName" value="<%= values.firstName || '' %>" required></label><br>
                    <label>Other Name:<br><input type="text" name="otherName" value="<%= values.otherName || '' %>"></label><br>
                    <label>Password (at least 8 characters):<br><input type="password" name="password" minlength="8" required></label><br>
                    <input type="submit" value="Sign up">
                </form>
                <p>Already have an account? <a href="/login">Log in</a></p>
            </div>
        </div>
<%- include('partials/footer') %>
